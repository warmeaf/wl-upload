{
  "name": "@wl-upload/shared",
  "version": "0.1.0",
  "description": "wl-upload 共享工具包",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "pretypecheck": "pnpm exec tsc -p tsconfig.json --declaration --emitDeclarationOnly",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "^7.3.0",
    "vitest": "^4.0.15"
  }
}

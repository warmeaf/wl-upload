{
  "name": "wl-upload",
  "version": "0.1.0",
  "private": true,
  "description": "高性能大文件分片上传解决方案",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "dev": "concurrently -n server,examples -c blue,green \"pnpm --filter @wl-upload/server dev\" \"pnpm --filter wl-upload-examples dev\"",
    "dev:server": "pnpm --filter @wl-upload/server dev",
    "dev:examples": "pnpm --filter wl-upload-examples dev",
    "dev:client": "pnpm --filter @wl-upload/client dev",
    "build": "pnpm --filter \"./packages/*\" build",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm lint:fix && pnpm format",
    "typecheck": "tsc --noEmit -p tsconfig.root.json && pnpm --filter \"./packages/*\" typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.9",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "only-allow": "^1.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "license": "MIT"
}

{
  "name": "@wl-upload/server",
  "version": "0.1.0",
  "description": "wl-upload 服务端包",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@wl-upload/shared": "workspace:*",
    "hono": "^4.11.1",
    "mongodb": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.15"
  }
}
